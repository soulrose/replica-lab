# ramaservice on Replica Lab: Spring profile dev, settings from vault-dev (team token)
SPRING_PROFILES_ACTIVE=dev
SPRING_CLOUD_VAULT_URI=https://vault-dev.rama.mahidol.ac.th
# SPRING_CLOUD_VAULT_TOKEN lives in apps/ramaservice.local.env (not in git; ask the team for it)
# shared dev infra: no schema changes, no scheduled jobs from local replicas
SPRING_LIQUIBASE_ENABLED=false
RAMA_LIQUIBASE_ENABLED=false
SPRING_QUARTZ_START=false
SPRING_QUARTZ_AUTO_STARTUP=false
# do not register local replicas in dev Eureka
EUREKA_CLIENT_ENABLED=false
SPRING_CLOUD_DISCOVERY_ENABLED=false
SPRING_CLOUD_SERVICE_REGISTRY_AUTO_REGISTRATION_ENABLED=false
# each replica opens its own DB pool: keep it small
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=1
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70
